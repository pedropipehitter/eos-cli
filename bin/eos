#!/usr/bin/env bash
# eos: manage ETC Eos Family Software release downloads
# https://github.com/pedropipehitter/eos-cli

set -euo pipefail

REPO="pedropipehitter/eos-software"
ROOT="${EOS_HOME:-$HOME/.eos}/versions"

die() { echo "eos: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }

need gh

normalize_tag() {
  local v="$1"
  [[ -z "$v" ]] && die "version required"
  [[ "$v" == v* ]] || v="v$v"
  printf '%s' "$v"
}

cmd_list() {
  gh release list -R "$REPO" -L 100
}

cmd_get() {
  local platform=mac pattern='*Mac*' args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --pc)  platform=pc;  pattern='*PC*';  shift ;;
      --mac) platform=mac; pattern='*Mac*'; shift ;;
      --)    shift; args+=("$@"); break ;;
      -*)    die "unknown flag: $1" ;;
      *)     args+=("$1"); shift ;;
    esac
  done
  [[ ${#args[@]} -ge 1 ]] || die "usage: eos get [--pc|--mac] <version>"
  local tag dest
  tag=$(normalize_tag "${args[0]}")
  dest="$ROOT/$tag"
  mkdir -p "$dest"
  echo "Downloading $tag ($platform) to $dest"
  gh release download "$tag" -R "$REPO" -D "$dest" --pattern "$pattern" --clobber
  ls -lh "$dest"
}

cmd_latest() {
  local platform_flag="" major="" args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --pc|--mac) platform_flag="$1"; shift ;;
      *)          args+=("$1"); shift ;;
    esac
  done
  major="${args[0]:-}"
  local tag
  if [[ -z "$major" ]]; then
    tag=$(gh release view -R "$REPO" --json tagName -q .tagName)
  else
    tag=$(gh release list -R "$REPO" -L 200 --json tagName -q '.[].tagName' \
          | grep -E "^v${major}\." \
          | sort -V \
          | tail -1)
    [[ -n "$tag" ]] || die "no releases found for major version $major"
  fi
  if [[ -n "$platform_flag" ]]; then
    cmd_get "$platform_flag" "$tag"
  else
    cmd_get "$tag"
  fi
}

cmd_installed() {
  if [[ ! -d "$ROOT" ]] || [[ -z "$(ls -A "$ROOT" 2>/dev/null)" ]]; then
    echo "(no installed versions)"
    return 0
  fi
  du -sh "$ROOT"/*/ 2>/dev/null | sort -k2
}

cmd_rm() {
  [[ $# -ge 1 ]] || die "usage: eos rm <version>"
  local tag dir
  tag=$(normalize_tag "$1")
  dir="$ROOT/$tag"
  [[ -d "$dir" ]] || die "not installed: $tag"
  rm -rf "$dir"
  echo "Removed $tag"
}

cmd_clean() {
  [[ -d "$ROOT" ]] || { echo "(nothing to clean)"; return 0; }
  local keep
  keep=$(ls -1 "$ROOT" 2>/dev/null | sort -V | tail -1) || true
  [[ -n "$keep" ]] || { echo "(nothing to clean)"; return 0; }
  echo "Keeping $keep"
  find "$ROOT" -mindepth 1 -maxdepth 1 -type d ! -name "$keep" -print -exec rm -rf {} +
}

usage() {
  cat <<EOF
eos: manage ETC Eos Family Software releases from $REPO

Usage:
  eos list                            list remote release tags
  eos get [--pc|--mac] <version>      download the installer for that version
  eos latest [--pc|--mac] [major]     download the newest overall, or newest
                                      in a major line (e.g. \`eos latest 2\`)
  eos installed                       list local downloads with sizes
  eos rm <version>                    delete one local version
  eos clean                           keep newest local version, delete rest

Platform: defaults to --mac (.dmg). Use --pc to get the Windows installer
(.exe), which is also the installer for ETC consoles (they run Windows).
Mac and PC files for the same version coexist in the same tag folder.

Versions can be given as \`3.3.6\` or \`v3.3.6\`.
Downloads live in \${EOS_HOME:-\$HOME/.eos}/versions/<tag>/
EOF
}

case "${1:-}" in
  list)       shift; cmd_list "$@" ;;
  get)        shift; cmd_get "$@" ;;
  latest)     shift; cmd_latest "$@" ;;
  installed)  shift; cmd_installed "$@" ;;
  rm)         shift; cmd_rm "$@" ;;
  clean)      shift; cmd_clean "$@" ;;
  ""|-h|--help|help) usage ;;
  *) echo "eos: unknown command: $1" >&2; usage >&2; exit 2 ;;
esac
